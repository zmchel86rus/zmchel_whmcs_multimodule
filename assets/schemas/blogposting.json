{
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": "{{TITLE}}",
    "description": "{{DESCRIPTION}}",
    "url": "{{URL}}",
    "image": "{{IMAGE}}",
    "inLanguage": "{{LANG_BCP47}}",
    "datePublished": "{{DATE_PUBLISHED}}",
    "dateModified": "{{DATE_MODIFIED}}",
    "articleBody": "{{ARTICLE_BODY}}",
    "author": {
        "@type": "Person",
        "name": "{{AUTHOR_NAME}}",
        "url": "{{AUTHOR_URL}}"
    },
    "publisher": {
        "@type": "Organization",
        "name": "{{SITE_NAME}}",
        "url": "{{SITE_URL}}",
        "logo": {
            "@type": "ImageObject",
            "url": "{{ORGANIZATION_LOGO}}"
        }
    },
    "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": "{{URL}}"
    }
}